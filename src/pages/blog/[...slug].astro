---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { mdxComponents } from "../../mdx-components.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const allPosts = await getCollection("blog").then((posts) =>
  posts.sort(
    (a, b) =>
      new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime(),
  ),
);

const post = Astro.props;
const postIndex = allPosts.findIndex((p) => p.id === post.id);
const previousPost = allPosts[postIndex - 1] ?? null;
const nextPost = allPosts[postIndex + 1] ?? null;
const { Content } = await render(post);
---

<BlogPost {...post.data} previousPost={previousPost} nextPost={nextPost}>
  <Content components={mdxComponents} />
</BlogPost>
